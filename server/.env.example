PORT=8787
# Paths to the binaries; defaults to whatever is on PATH.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# Browser origins allowed to call the API (only needed when web and server are on different domains).
# CORS_ORIGIN=https://your-app.vercel.app
# Number of proxies in front of the server (Railway/Fly/nginx = 1).
# TRUST_PROXY=1
# Self-update yt-dlp every N hours (0 = off).
# YTDLP_UPDATE_HOURS=24
# MAX_CONCURRENT_JOBS=3
# MAX_FILESIZE=1500M
# Pass HEVC through instead of re-encoding to H.264 (iOS Photos plays both).
# ALLOW_HEVC=1
